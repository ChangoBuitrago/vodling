{
  "name": "vodling-protocol",
  "version": "1.0.0",
  "description": "Vodling Protocol - Principal Protected ETH Staking",
  "scripts": {
    "start": "./start.sh",
    "start:blockchain": "./bootstrap/start-blockchain.sh",
    "deploy": "./bootstrap/deploy-contracts.sh",
    "stop:blockchain": "./bootstrap/stop-blockchain.sh",
    "dev": "npm run start:blockchain && npm run deploy && npm start",
    "build": "forge build",
    "test": "forge test",
    "test:verbose": "forge test -vvv",
    "test:gas": "forge test --gas-report",
    "coverage": "forge coverage",
    "lint": "forge fmt",
    "size": "forge build --sizes"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^4.9.0"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChangoBuitrago/vodling.git"
  },
  "keywords": [],
